# Copy to .env and adjust if this box's paths differ. Never commit .env.
#
# Loaded by systemd via EnvironmentFile= in csm-agent@.service. Every
# variable below is optional - if unset (or this file is missing entirely),
# host-agent/lib/Sessions.php falls back to the values shown here, so a
# fresh checkout with no .env behaves exactly as before this file existed.
#
# tests/.env.testing is the analogous file for the test suite - it points
# these same variables at an isolated tmux socket and a fixture claude
# binary instead of the real host session. See tests/run.sh.

# --- Real claude CLI binary (argv[0] must match this exactly) ---
CLAUDE_BIN=/home/andres/.local/bin/claude

# --- Root directory offered as "workdir" choices in the New Session form ---
WWW_ROOT=/home/andres/www

# --- Upper bound for the New Session folder browser - browsing can never
# go above this directory, even though WWW_ROOT is where it starts ---
HOME_ROOT=/home/andres

# --- tmux socket this agent drives (-S flag) ---
TMUX_SOCKET=/tmp/tmux-1000/default

# --- Where per-session sidecar metadata (workdir, spawned_at) is stored ---
SIDECAR_DIR=/run/user/1000/csm-sessions

# --- Seconds of inactivity before "Kill inactive" considers a session dead ---
CLEANUP_THRESHOLD_SECONDS=43200

# --- Initial tmux pane size for a newly created session (-x/-y on
# new-session). No real client is ever attached to inherit a size from, so
# without this it falls back to tmux's own 80x24 default - nowhere near
# enough for Claude Code's own TUI to render a long tool-permission
# preview (a big Write, a long Bash script) without cutting it short.
# Only affects sessions created AFTER this is set - existing ones stay at
# whatever size they were created with. ---
TMUX_PANE_WIDTH=200
TMUX_PANE_HEIGHT=150

# --- claude-quota binary (scrapes Claude Code's own /usage panel via a
# detached screen session - see the script itself for the mechanism).
# Optional: if unset/missing/non-executable, the "quota" action just
# returns ok=false and the UI footer shows "Quota unavailable". ---
CLAUDE_QUOTA_BIN=/home/andres/dotfiles/bin/claude-quota

# --- Where the last successful quota reading is cached. The scrape is
# slow (10-40s, it drives a real TUI), so this is reused across requests
# until QUOTA_CACHE_TTL_SECONDS elapses instead of re-running every time. ---
QUOTA_CACHE_FILE=/run/user/1000/csm-agent-quota-cache.json

# --- How long a cached quota reading is considered fresh, in seconds ---
QUOTA_CACHE_TTL_SECONDS=300

# --- Max seconds to let claude-quota run before giving up ---
QUOTA_TIMEOUT_SECONDS=90

# --- Web Push notifications (see the README's "Web Push notifications"
# section for the one-time setup). Both keys empty/unset (the default on
# a fresh checkout) means push_configured() in lib/Push.php returns false
# and every push-related action - the systemd timer's check, the
# subscribe endpoint - is a harmless no-op. Generate a real pair with:
#   php -r "require 'vendor/autoload.php'; print_r(Minishlink\WebPush\VAPID::createVapidKeys());"
# ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Required by the Web Push spec (a contact point the push service can
# reach you at if it needs to) - any mailto: or https: URI works. ---
VAPID_SUBJECT=mailto:dasc495@gmail.com

# --- Where subscribed devices are stored. Deliberately NOT under
# /run/user/1000 like the sidecar/quota-cache files above - those are
# fine to lose on reboot (tied to sessions that don't survive a reboot
# either), a phone's push subscription shouldn't need to be redone just
# because the host restarted. ---
PUSH_SUBSCRIPTIONS_FILE=/home/andres/www/claude-session-manager/host-agent/state/push-subscriptions.json

# --- Tracks each session's last-known blocked/working/idle state, so the
# push-check timer only notifies on the transition INTO blocked, not on
# every tick a prompt sits unanswered. ---
PUSH_STATE_FILE=/home/andres/www/claude-session-manager/host-agent/state/push-session-state.json
